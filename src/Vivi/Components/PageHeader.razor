<header class="page-header">
    <h1>@Title</h1>
    @if (Subtitle is not null)
    {
        <p class="subtitle">@Subtitle</p>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }
}
